### Verify that an unsigned GitHub issues payload is rejected before parsing.
POST {{baseUrl}}/github/webhooks
Content-Type: application/json
X-GitHub-Event: issues
X-Hub-Signature-256: sha256=invalid

{
  "action": "opened",
  "repository": {
    "id": 1001,
    "name": "example-repository",
    "full_name": "example-owner/example-repository",
    "html_url": "https://github.com/example-owner/example-repository",
    "private": false
  },
  "sender": {
    "id": 2001,
    "login": "example-sender"
  },
  "issue": {
    "id": 3001,
    "number": 1,
    "title": "Example issue",
    "body": "Webhook smoke-test payload",
    "state": "open",
    "html_url": "https://github.com/example-owner/example-repository/issues/1",
    "user": {
      "id": 2002,
      "login": "example-author"
    },
    "labels": [],
    "assignees": [],
    "comments": 0,
    "created_at": "2026-09-15T00:00:00Z",
    "updated_at": "2026-09-15T00:00:00Z",
    "closed_at": null
  }
}

> {%
  client.test("rejects an invalid GitHub webhook signature", () => {
    client.assert(response.status === 401, "expected HTTP 401");
    client.assert(
      response.body.message === "Invalid GitHub webhook signature",
      "expected an invalid-signature response",
    );
  });
%}
